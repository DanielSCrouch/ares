(define (domain attacksurface)
(:requirements :adl :typing)
(:types 	host service loot 	- target
					host os port vuln 	- knowledge
					attempted failed		- history
					)

(:predicates (found           ?x - host)
						 (is_host         ?x - host)
						 (scanned			    ?x - host)
						 (has_failed	    ?x - vuln)
						 (has_progress1		?x - target)
						 (has_progress2   ?x - target)
			       (has_CVE_2007_6750 ?x - host)
			       (has_CVE_2008_4114 ?x - host)
			       (has_CVE_2008_4250 ?x - host)
			       (has_CVE_2010_0425 ?x - host)
			       (has_CVE_2011_3368 ?x - host)
			       (has_CVE_2011_4885 ?x - host)
			       (has_CVE_2012_1823 ?x - host)
			       (has_CVE_2014_0195 ?x - host)
			       (has_CVE_2014_0224 ?x - host)
			       (has_CVE_2014_3566 ?x - host)
			       (has_CVE_2017_0143 ?x - host)
			       (has_CVE_2017_0144 ?x - host)
			       (has_CVE_2017_0145 ?x - host)
			       (has_CVE_2017_0146 ?x - host)
			       (has_CVE_2017_0147 ?x - host)
			       (has_CVE_2017_0148 ?x - host)
			       (has_CVE_1999_0524 ?x - host)
			       (has_CVE_1999_0105 ?x - host)
			       (has_CVE_1999_0106 ?x - host)
			       (has_CVE_1999_0519 ?x - host)
			       (has_CVE_1999_0520 ?x - host)
			       (has_CVE_1999_0612 ?x - host)
			       (has_CVE_2002_1117 ?x - host)
			       (has_CVE_2003_1567 ?x - host)
						 (has_os          ?x - os 		?y - host))

(:action full_scan
	:parameters   (?x - host)
	:precondition (not (scanned ?x))
	:effect       (and (scanned ?x)
								 		 (has_progress1 ?x))
								)

(:action exploit_cve_2008_4250
 	:parameters   		(?x - host)
 	:precondition 		(and (scanned ?x)
 									  		 (has_CVE_2008_4250 ?x))
 	:effect      		  (and (is_host ?x)
 									  		 (has_progress2 ?x))
										)

)
